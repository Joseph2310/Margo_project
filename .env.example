APP_NAME=Beneficiaries API
APP_VERSION=1.0.0
APP_ENV=development
APP_DEBUG=false
API_PREFIX=/api/v1
POSTGRES_DB=beneficiaries
POSTGRES_USER=beneficiaries
POSTGRES_PASSWORD=beneficiaries
POSTGRES_PORT=5432
API_PORT=8000
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
MAILPIT_MAX_MESSAGES=500
DATABASE_URL=postgresql+psycopg://beneficiaries:beneficiaries@db:5432/beneficiaries
CORS_ORIGINS=*
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
VERIFICATION_CODE_TTL_SECONDS=600
VERIFICATION_MAX_ATTEMPTS=5
DEV_VERIFICATION_CODE=123456
EXPOSE_VERIFICATION_CODE=false
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=beneficiaries@local.test
SMTP_STARTTLS=false
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
AUTO_SEED=true
DEMO_USER_EMAIL=joy.barakat@hotmail.com
DEMO_USER_PASSWORD=Password1
WHATSAPP_GROUP_URL=
